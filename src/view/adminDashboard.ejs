<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="icon" type="image/png" href="/image/favicon.png">
  </head>
  <body>
    <!-- ============ ICON SPRITE (ẩn) ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-calendar-check" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
        <path d="m9 16 2 2 4-4" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-users" viewBox="0 0 24 24">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </symbol>
      <symbol id="i-dollar" viewBox="0 0 24 24">
        <path d="M12 1v22" />
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-plus" viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </symbol>
      <symbol id="i-edit" viewBox="0 0 24 24">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
      </symbol>
      <symbol id="i-trash" viewBox="0 0 24 24">
        <path d="M3 6h18" />
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item is-active">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <!-- Lớp phủ khi mở menu trên mobile -->
    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm lịch đặt, khách hàng…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <div class="page-head">
          <h1>Tổng quan</h1>
          <p>Chào mừng trở lại! Đây là tình hình hoạt động của hệ thống hôm nay.</p>
        </div>

        <!-- ===== Thống kê ===== -->
        <section class="stat-grid">
          <article class="stat-card stat-card--teal">
            <div class="stat-card__icon">
              <svg class="ico"><use href="#i-calendar-check" /></svg>
            </div>
            <p class="stat-card__label">Lịch đặt hôm nay</p>
            <p class="stat-card__value"><%= stats ? stats.todayBookings : 0 %></p>
          </article>

          <article class="stat-card stat-card--green">
            <div class="stat-card__icon">
              <svg class="ico"><use href="#i-dollar" /></svg>
            </div>
            <p class="stat-card__label">Doanh thu</p>
            <p class="stat-card__value">
              <%= stats ? Number(stats.totalRevenue || 0).toLocaleString('vi-VN') : '0' %>
              <small>đ</small>
            </p>
          </article>

          <article class="stat-card stat-card--blue">
            <div class="stat-card__icon">
              <svg class="ico"><use href="#i-users" /></svg>
            </div>
            <p class="stat-card__label">Tổng người dùng</p>
            <p class="stat-card__value"><%= stats ? stats.totalUsers : 0 %></p>
          </article>

          <article class="stat-card stat-card--orange">
            <div class="stat-card__icon">
              <svg class="ico"><use href="#i-package" /></svg>
            </div>
            <p class="stat-card__label">Tổng dịch vụ</p>
            <p class="stat-card__value"><%= stats ? stats.totalResources : 0 %></p>
          </article>
        </section>

        <!-- ===== Lịch đặt gần đây ===== -->
        <section class="section-card">
          <header class="section-card__head">
            <div>
              <h3>Lịch đặt gần đây</h3>
              <p class="section-card__hint">Cập nhật mới nhất từ hệ thống</p>
            </div>
            <a href="/admin/bookings" class="btn-ghost">Xem tất cả</a>
          </header>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Khách hàng</th>
                  <th>Dịch vụ</th>
                  <th>Thời gian</th>
                  <th>Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats && stats.recentBookings && stats.recentBookings.length) { %>
                  <% stats.recentBookings.forEach(function(b) { %>
                  <tr>
                    <td class="cell-strong"><%= b.FullName %></td>
                    <td><%= b.ResourceName %></td>
                    <td>
                      <span class="cell-date">
                        <%= new Date(b.StartTime).toLocaleDateString('vi-VN') %>
                      </span>
                      <span class="cell-time">
                        <%= new Date(b.StartTime).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'}) %>
                      </span>
                    </td>
                    <td>
                      <% if (b.Status === 'Pending') { %>
                        <span class="badge badge-pending">Chờ xác nhận</span>
                      <% } else if (b.Status === 'Confirmed') { %>
                        <span class="badge badge-confirmed">Đã xác nhận</span>
                      <% } else if (b.Status === 'Cancelled') { %>
                        <span class="badge badge-cancelled">Đã hủy</span>
                      <% } else { %>
                        <span class="badge badge-done">Hoàn thành</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="empty">Chưa có lịch đặt nào</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ===== Quản lý Users ===== -->
        <section class="section-card">
          <header class="section-card__head">
            <div>
              <h3>Quản lý tài khoản</h3>
              <p class="section-card__hint">
                <%= dataUser && dataUser.length ? dataUser.length : 0 %> tài khoản trong hệ thống
              </p>
            </div>
            <a href="/create" class="btn-primary">
              <svg class="ico ico--sm"><use href="#i-plus" /></svg>
              Tạo tài khoản
            </a>
          </header>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Họ tên</th>
                  <th>Email</th>
                  <th>Số điện thoại</th>
                  <th>Vai trò</th>
                  <th>Trạng thái</th>
                  <th class="th-right">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (dataUser && dataUser.length) { %>
                  <% dataUser.forEach(function(user) { %>
                    <tr>
                      <td>
                        <div class="user-cell">
                          <span class="user-cell__avatar">
                            <%= (user.FullName || 'U').trim().charAt(0).toUpperCase() %>
                          </span>
                          <span class="cell-strong"><%= user.FullName %></span>
                        </div>
                      </td>
                      <td><%= user.Email %></td>
                      <td><%= user.Phone || '—' %></td>
                      <td>
                        <span class="badge <%= user.Role === 'admin' ? 'badge-admin' : 'badge-user' %>">
                          <%= user.Role ? user.Role.toUpperCase() : 'USER' %>
                        </span>
                      </td>
                      <td>
                        <% if (user.Status === 'active') { %>
                          <span class="status status--active">Hoạt động</span>
                        <% } else { %>
                          <span class="status status--locked">Đã khóa</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="actions">
                          <a href="/update/<%= user.UserID %>" class="btn-icon btn-edit">
                            <svg class="ico ico--sm"><use href="#i-edit" /></svg>
                            Sửa
                          </a>
                          <form
                            action="/delete-user"
                            method="post"
                            onsubmit="return confirm('Xóa tài khoản này?');"
                          >
                            <input type="hidden" name="id" value="<%= user.UserID %>" />
                            <button type="submit" class="btn-icon btn-delete">
                              <svg class="ico ico--sm"><use href="#i-trash" /></svg>
                              Xóa
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="empty">Chưa có dữ liệu người dùng</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>