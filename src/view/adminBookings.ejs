<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Lịch đặt — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/bookings.css" />
  </head>
  <body>
    <!-- ============ ICON SPRITE (ẩn) ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-clock" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </symbol>
      <symbol id="i-mail" viewBox="0 0 24 24">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-10 6L2 7" />
      </symbol>
      <symbol id="i-filter" viewBox="0 0 24 24">
        <path d="M22 3H2l8 9.5V19l4 2v-8.5z" />
      </symbol>
      <symbol id="i-download" viewBox="0 0 24 24">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <path d="M7 10l5 5 5-5M12 15V3" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item is-active">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <!-- Lớp phủ khi mở menu trên mobile -->
    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm theo khách hàng, dịch vụ…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <!-- Page head -->
        <div class="page-head">
          <div>
            <h1>Quản lý Lịch đặt</h1>
            <p>
              Danh sách tất cả lịch đặt trong hệ thống.
              <% if (bookings && bookings.length) { %>
                <strong class="page-head__count"><%= bookings.length %></strong> lịch đặt
              <% } %>
            </p>
          </div>
          <div class="page-head__actions">
            <button class="btn-ghost" type="button">
              <svg class="ico ico--sm"><use href="#i-filter" /></svg>
              Bộ lọc
            </button>
            <button class="btn-ghost" type="button">
              <svg class="ico ico--sm"><use href="#i-download" /></svg>
              Xuất Excel
            </button>
          </div>
        </div>

        <!-- Bảng lịch đặt -->
        <section class="section-card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Khách hàng</th>
                  <th>Dịch vụ</th>
                  <th>Thời gian đặt</th>
                  <th>Số tiền (VNĐ)</th>
                  <th>Trạng thái</th>
                  <th class="th-right">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (bookings && bookings.length) { %>
                  <% bookings.forEach(function(b) { %>
                  <tr>
                    <!-- Khách hàng -->
                    <td>
                      <div class="user-cell">
                        <span class="user-cell__avatar">
                          <%= (b.FullName || 'U').trim().charAt(0).toUpperCase() %>
                        </span>
                        <div class="user-cell__info">
                          <span class="cell-strong"><%= b.FullName %></span>
                          <span class="user-cell__email">
                            <svg class="ico ico--xs"><use href="#i-mail" /></svg>
                            <%= b.Email %>
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Dịch vụ -->
                    <td>
                      <span class="cell-strong"><%= b.ResourceName %></span>
                    </td>

                    <!-- Thời gian -->
                    <td>
                      <div class="time-cell">
                        <svg class="ico ico--sm time-cell__icon"><use href="#i-clock" /></svg>
                        <div>
                          <span class="time-cell__date">
                            <%= new Date(b.StartTime).toLocaleDateString('vi-VN') %>
                          </span>
                          <span class="time-cell__range">
                            <%= new Date(b.StartTime).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'}) %>
                            <span class="time-cell__sep">→</span>
                            <%= new Date(b.EndTime).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'}) %>
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Số tiền -->
                    <td>
                      <span class="amount">
                        <%= b.TotalAmount ? Number(b.TotalAmount).toLocaleString('vi-VN') : '0' %>
                        <small>đ</small>
                      </span>
                    </td>

                    <!-- Trạng thái -->
                    <td>
                      <% if (b.Status === 'Pending') { %>
                        <span class="badge badge-pending">
                          <span class="badge__dot"></span>
                          Chờ xác nhận
                        </span>
                      <% } else if (b.Status === 'Confirmed') { %>
                        <span class="badge badge-confirmed">
                          <span class="badge__dot"></span>
                          Đã xác nhận
                        </span>
                      <% } else if (b.Status === 'Cancelled') { %>
                        <span class="badge badge-cancelled">
                          <span class="badge__dot"></span>
                          Đã hủy
                        </span>
                      <% } else { %>
                        <span class="badge badge-done">
                          <span class="badge__dot"></span>
                          Hoàn thành
                        </span>
                      <% } %>
                    </td>

                    <!-- Thao tác -->
                    <td>
                      <div class="actions">
                        <% if (b.Status === 'Pending') { %>
                          <form
                            action="/admin/bookings/confirm"
                            method="post"
                            onsubmit="return confirm('Xác nhận lịch đặt này?');"
                          >
                            <input type="hidden" name="bookingId" value="<%= b.BookingID %>" />
                            <button type="submit" class="btn-confirm">
                              <svg class="ico ico--sm"><use href="#i-check" /></svg>
                              Xác nhận
                            </button>
                          </form>
                        <% } else { %>
                          <span class="no-action">—</span>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="empty">
                      <div class="empty__icon">
                        <svg class="ico"><use href="#i-calendar" /></svg>
                      </div>
                      <p class="empty__title">Chưa có lịch đặt nào</p>
                      <p class="empty__sub">Khi khách hàng đặt lịch, thông tin sẽ hiển thị tại đây.</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>