<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Dịch vụ — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/resources.css" />
  <link rel="icon" type="image/png" href="/image/favicon.png">
  </head>
  <body>
    <!-- ============ ICON SPRITE ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-plus" viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </symbol>
      <symbol id="i-edit" viewBox="0 0 24 24">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
      </symbol>
      <symbol id="i-trash" viewBox="0 0 24 24">
        <path d="M3 6h18" />
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </symbol>
      <symbol id="i-filter" viewBox="0 0 24 24">
        <path d="M22 3H2l8 9.5V19l4 2v-8.5z" />
      </symbol>
      <symbol id="i-tag" viewBox="0 0 24 24">
        <path d="M20.59 13.41 12 22l-9-9V4a1 1 0 0 1 1-1h9z" />
        <circle cx="7.5" cy="7.5" r="1.5" />
      </symbol>
      <symbol id="i-dollar" viewBox="0 0 24 24">
        <path d="M12 1v22" />
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
      </symbol>
      <symbol id="i-empty-box" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item is-active">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm dịch vụ…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <!-- Page head -->
        <div class="page-head">
          <div>
            <h1>Quản lý Dịch vụ &amp; Tài nguyên</h1>
            <p>
              Danh sách tất cả dịch vụ trong hệ thống.
              <% if (resources && resources.length) { %>
                <strong class="page-head__count"><%= resources.length %></strong> dịch vụ
              <% } %>
            </p>
          </div>
          <div class="page-head__actions">
            <a href="/admin/resources/create" class="btn-primary">
              <svg class="ico ico--sm"><use href="#i-plus" /></svg>
              Thêm dịch vụ mới
            </a>
          </div>
        </div>

        <!-- Bảng dịch vụ -->
        <section class="section-card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Tên dịch vụ</th>
                  <th>Phân loại</th>
                  <th>Giá tiền (VNĐ)</th>
                  <th>Trạng thái</th>
                  <th class="th-right">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (resources && resources.length) { %>
                  <% resources.forEach(function(r) { %>
                  <tr>
                    <!-- ID -->
                    <td>
                      <span class="cell-id">#<%= r.ResourceID %></span>
                    </td>

                    <!-- Tên + mô tả -->
                    <td>
                      <div class="resource-cell">
                        <span class="resource-cell__icon">
                          <svg class="ico ico--sm"><use href="#i-package" /></svg>
                        </span>
                        <div class="resource-cell__info">
                          <span class="cell-strong"><%= r.Name %></span>
                          <% if (r.Description) { %>
                            <span class="resource-cell__desc"><%= r.Description %></span>
                          <% } %>
                        </div>
                      </div>
                    </td>

                    <!-- Phân loại -->
                    <td>
                      <span class="chip">
                        <svg class="ico ico--xs"><use href="#i-tag" /></svg>
                        <%= r.Type || 'Khác' %>
                      </span>
                    </td>

                    <!-- Giá -->
                    <td>
                      <% if (r.Price && Number(r.Price) > 0) { %>
                        <span class="amount">
                          <%= Number(r.Price).toLocaleString('vi-VN') %>
                          <small>đ</small>
                        </span>
                      <% } else { %>
                        <span class="amount amount--free">Miễn phí</span>
                      <% } %>
                    </td>

                    <!-- Trạng thái -->
                    <td>
                      <% if (r.Status === 'available') { %>
                        <span class="badge badge-available">
                          <span class="badge__dot"></span>
                          Đang hoạt động
                        </span>
                      <% } else if (r.Status === 'maintenance') { %>
                        <span class="badge badge-maintenance">
                          <span class="badge__dot"></span>
                          Bảo trì
                        </span>
                      <% } else { %>
                        <span class="badge badge-out">
                          <span class="badge__dot"></span>
                          Ngưng hoạt động
                        </span>
                      <% } %>
                    </td>

                    <!-- Thao tác -->
                    <td>
                      <div class="actions">
                        <a
                          href="/admin/resources/edit/<%= r.ResourceID %>"
                          class="btn-icon btn-edit"
                        >
                          <svg class="ico ico--sm"><use href="#i-edit" /></svg>
                          Sửa
                        </a>
                        <form
                          action="/admin/resources/delete"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa dịch vụ này? Mọi lịch đặt liên quan cũng sẽ bị xóa!');"
                        >
                          <input type="hidden" name="id" value="<%= r.ResourceID %>" />
                          <button type="submit" class="btn-icon btn-delete">
                            <svg class="ico ico--sm"><use href="#i-trash" /></svg>
                            Xóa
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="empty">
                      <div class="empty__icon">
                        <svg class="ico"><use href="#i-empty-box" /></svg>
                      </div>
                      <p class="empty__title">Chưa có dịch vụ nào</p>
                      <p class="empty__sub">
                        Bấm nút <strong>“Thêm dịch vụ mới”</strong> ở góc trên bên phải để bắt đầu.
                      </p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>