<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Booking System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/user-home.css" />
  
    <style>
      .services-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 20px;
        padding-bottom: 20px;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
      }
      .service-card {
        flex: 0 0 calc(25% - 15px);
        scroll-snap-align: start;
        min-width: 280px;
      }
      .services-grid::-webkit-scrollbar {
        height: 8px;
      }
      .services-grid::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
      }
      .services-grid::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
      }
      @media (max-width: 1024px) {
        .service-card { flex: 0 0 calc(33.333% - 14px); }
      }
      @media (max-width: 768px) {
        .service-card { flex: 0 0 calc(50% - 10px); }
      }
      @media (max-width: 480px) {
        .service-card { flex: 0 0 100%; }
      }
    </style>
  </head>
  <body>
    <!-- ============ ICON SPRITE ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-clock" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </symbol>
      <symbol id="i-sparkle" viewBox="0 0 24 24">
        <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-arrow-right" viewBox="0 0 24 24">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-tag" viewBox="0 0 24 24">
        <path d="M20.59 13.41 12 22l-9-9V4a1 1 0 0 1 1-1h9z" />
        <circle cx="7.5" cy="7.5" r="1.5" />
      </symbol>
      <symbol id="i-user" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </symbol>
      <symbol id="i-shield" viewBox="0 0 24 24">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </symbol>
      <symbol id="i-zap" viewBox="0 0 24 24">
        <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
      </symbol>
      <symbol id="i-star" viewBox="0 0 24 24">
        <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </symbol>
    </svg>

    <!-- ============ HEADER ============ -->
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-badge">SB</span>
          <span class="brand-text">Smart<strong>Booking</strong></span>
        </a>

        <nav class="nav-links">
          <a href="#services">Dịch vụ</a>
          <a href="#booking">Đặt lịch</a>
          <a href="/my-bookings?userId=<%= userId %>&name=<%= encodeURIComponent(userName) %>">Lịch sử</a>
          <a href="#contact">Liên hệ</a>
        </nav>

        <div class="user-menu">
          <div class="user-info">
            <span class="user-avatar"><%= (userName || 'U').trim().charAt(0).toUpperCase() %></span>
            <span class="user-name"><%= userName %></span>
          </div>
          <a class="logout-link" href="/login" aria-label="Đăng xuất" title="Đăng xuất">
            <svg class="ico"><use href="#i-logout" /></svg>
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-card">
              <span class="hero__eyebrow">
                <svg class="ico ico--sm"><use href="#i-sparkle" /></svg>
                Đặt lịch trong vài giây
              </span>

              <h1>
                Đặt lịch nhanh chóng,
                <span class="hero__accent">tiện lợi</span>
                và chuyên nghiệp
              </h1>

              <p>
                Chọn dịch vụ bạn cần, chọn khung giờ phù hợp và gửi yêu cầu
                đặt lịch chỉ trong vài bước đơn giản.
              </p>

              <div class="hero-actions">
                <a class="btn btn-primary" href="#booking">
                  Đặt lịch ngay
                  <svg class="ico ico--sm"><use href="#i-arrow-right" /></svg>
                </a>
                <a class="btn btn-secondary" href="#services">Xem dịch vụ</a>
              </div>

              <div class="hero-stats">
                <div class="hero-stat">
                  <span class="hero-stat__value">24/7</span>
                  <span class="hero-stat__label">Đặt lịch trực tuyến</span>
                </div>
                <div class="hero-stat__divider"></div>
                <div class="hero-stat">
                  <span class="hero-stat__value">100%</span>
                  <span class="hero-stat__label">Xác nhận nhanh chóng</span>
                </div>
                <div class="hero-stat__divider"></div>
                <div class="hero-stat">
                  <span class="hero-stat__value">0đ</span>
                  <span class="hero-stat__label">Phí đặt lịch</span>
                </div>
              </div>
            </div>

            <div class="hero-visual">
              <div class="hero-visual__glow"></div>
              <img src="/image/booking.jpg" alt="Booking illustration" />
              <div class="hero-float hero-float--1">
                <span class="hero-float__icon">
                  <svg class="ico ico--sm"><use href="#i-calendar" /></svg>
                </span>
                <div>
                  <strong>Đặt lịch thành công</strong>
                  <small>Vài phút trước</small>
                </div>
              </div>
              <div class="hero-float hero-float--2">
                <span class="hero-float__icon hero-float__icon--green">
                  <svg class="ico ico--sm"><use href="#i-check" /></svg>
                </span>
                <div>
                  <strong>Đã xác nhận</strong>
                  <small>Bởi quản trị viên</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FEATURES ============ -->
      <section class="features">
        <div class="container features-grid">
          <div class="feature-item">
            <span class="feature-item__icon feature-item__icon--teal">
              <svg class="ico"><use href="#i-zap" /></svg>
            </span>
            <div>
              <strong>Đặt lịch siêu tốc</strong>
              <p>Chỉ 3 bước để hoàn tất yêu cầu đặt lịch.</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-item__icon feature-item__icon--blue">
              <svg class="ico"><use href="#i-shield" /></svg>
            </span>
            <div>
              <strong>An toàn &amp; bảo mật</strong>
              <p>Thông tin của bạn luôn được bảo vệ nghiêm ngặt.</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-item__icon feature-item__icon--purple">
              <svg class="ico"><use href="#i-star" /></svg>
            </span>
            <div>
              <strong>Dịch vụ chất lượng</strong>
              <p>Được kiểm duyệt và xác nhận bởi quản trị viên.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ SERVICES ============ -->
      <section id="services" class="section">
        <div class="container">
          <div class="section-title">
            <div>
              <span class="section-title__eyebrow">Dịch vụ</span>
              <h2>Dịch vụ nổi bật</h2>
              <p>Chọn một dịch vụ để tiến hành đặt lịch</p>
            </div>
            <div class="search-box">
              <svg class="ico"><use href="#i-search" /></svg>
              <input
                id="search-input"
                type="text"
                placeholder="Tìm dịch vụ theo tên…"
              />
            </div>
          </div>

          <div class="services-grid">
            <% if (resources && resources.length) { %>
              <% resources.forEach(function(r, index) { %>
              <div
                class="service-card <%= index === 0 ? 'active' : '' %>"
                data-service-name="<%= r.Name %>"
                data-service-id="<%= r.ResourceID %>"
                data-service-price="<%= r.Price || 0 %>"
              >
                <div class="service-card__media">
                    <% if (r.ImageUrl) { %>
                      <img src="<%= r.ImageUrl %>" alt="<%= r.Name %>" />
                    <% } else if (r.Type === 'Phòng họp') { %>
                      <img src="/image/service-ops.jpg" alt="<%= r.Name %>" />
                    <% } else if (r.Type === 'Y tế') { %>
                      <img src="/image/service-support.jpg" alt="<%= r.Name %>" />
                    <% } else if (r.Type === 'Bảo trì') { %>
                      <img src="/image/service-maintenance.jpg" alt="<%= r.Name %>" />
                    <% } else { %>
                      <img src="/image/service-tech.jpg" alt="<%= r.Name %>" />
                    <% } %>

                    <% if (r.Type) { %>
                    <span class="service-card__type">
                      <svg class="ico ico--xs"><use href="#i-tag" /></svg>
                      <%= r.Type %>
                    </span>
                  <% } %>

                  <span class="service-card__check">
                    <svg class="ico ico--sm"><use href="#i-check" /></svg>
                  </span>
                </div>

                <div class="service-card__content">
                  <h3><%= r.Name %></h3>
                  <p><%= r.Description || 'Dịch vụ chuyên nghiệp, chất lượng cao.' %></p>

                  <div class="service-card__footer">
                    <span class="service-card__price">
                      <%= r.Price ? Number(r.Price).toLocaleString('vi-VN') : '0' %>
                      <small>đ</small>
                    </span>
                    <span class="service-card__cta">
                      Chọn dịch vụ
                      <svg class="ico ico--xs"><use href="#i-arrow-right" /></svg>
                    </span>
                  </div>
                </div>
              </div>
              <% }) %>
            <% } else { %>
              <div class="empty-services">
                <p>Hiện chưa có dịch vụ nào. Vui lòng quay lại sau!</p>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- ============ BOOKING ============ -->
      <section id="booking" class="section section--booking">
        <div class="container">
          <div class="booking-panel">
            <!-- Cột chọn giờ -->
            <div class="booking-card">
              <div class="section-title section-title--compact">
                <div>
                  <span class="section-title__eyebrow">Bước 2</span>
                  <h2>Chọn khung giờ</h2>
                  <p id="result-text">Chọn dịch vụ và khung giờ</p>
                </div>
              </div>

              <div class="field">
                <label for="booking-date">
                  <svg class="ico ico--sm"><use href="#i-calendar" /></svg>
                  Chọn ngày
                </label>
                <input type="date" id="booking-date" />
              </div>

              <div class="field">
                <label>
                  <svg class="ico ico--sm"><use href="#i-clock" /></svg>
                  Chọn khung giờ
                </label>
                <div class="time-grid">
                  <button class="time-slot" type="button" data-time="08:00" data-end="09:30">08:00</button>
                  <button class="time-slot" type="button" data-time="09:30" data-end="11:00">09:30</button>
                  <button class="time-slot" type="button" data-time="11:00" data-end="12:30">11:00</button>
                  <button class="time-slot" type="button" data-time="13:30" data-end="15:00">13:30</button>
                  <button class="time-slot" type="button" data-time="15:00" data-end="16:30">15:00</button>
                  <button class="time-slot" type="button" data-time="16:30" data-end="18:00">16:30</button>
                </div>
              </div>

              <button class="btn btn-primary btn-block" type="button" id="confirm-booking-btn">
                <svg class="ico ico--sm"><use href="#i-check" /></svg>
                Xác nhận đặt lịch
              </button>
            </div>

            <!-- Cột tóm tắt -->
            <aside class="booking-card booking-card--summary">
              <div class="summary-head">
                <div class="summary-head__icon">
                  <svg class="ico"><use href="#i-calendar" /></svg>
                </div>
                <div>
                  <h2>Tóm tắt</h2>
                  <p>Kiểm tra thông tin trước khi xác nhận</p>
                </div>
              </div>

              <ul class="summary-list">
                <li>
                  <span class="summary-list__label">Dịch vụ</span>
                  <span class="summary-list__value" id="summary-service">Chưa chọn</span>
                </li>
                <li>
                  <span class="summary-list__label">Ngày</span>
                  <span class="summary-list__value" id="summary-date">Chưa chọn</span>
                </li>
                <li>
                  <span class="summary-list__label">Thời gian</span>
                  <span class="summary-list__value" id="summary-time">Chưa chọn</span>
                </li>
              </ul>

              <div class="summary-total">
                <span class="summary-total__label">Tổng thanh toán</span>
                <span class="summary-total__value" id="summary-price">0 đ</span>
              </div>

              <div class="summary-note">
                <svg class="ico ico--sm"><use href="#i-shield" /></svg>
                Miễn phí đặt lịch · Thanh toán sau khi hoàn tất
              </div>
            </aside>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer id="contact" class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="brand-badge brand-badge--sm">SB</span>
          <span>Smart Booking System</span>
        </div>
        <p class="footer-copy">© 2026 Smart Booking System. All rights reserved.</p>
      </div>
    </footer>

    <!-- ============ SUCCESS MODAL ============ -->
    <div id="booking-modal" class="modal-overlay hidden" role="dialog" aria-modal="true">
      <div class="modal-card">
        <div class="modal-card__icon">
          <svg class="ico"><use href="#i-check" /></svg>
        </div>
        <h3 id="modal-title">Đặt lịch thành công!</h3>
        <p id="modal-message">
          Lịch của bạn đã được ghi nhận. Vui lòng chờ xác nhận từ quản trị viên.
        </p>
        <button class="btn btn-primary btn-block" type="button" id="close-booking-modal">
          Hoàn tất
        </button>
      </div>
    </div>

    <!-- ============ SCRIPT ============ -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const serviceCards = Array.from(document.querySelectorAll('.service-card'));
        const timeSlots = Array.from(document.querySelectorAll('.time-slot'));
        const searchInput = document.getElementById('search-input');
        const resultText = document.getElementById('result-text');
        const bookingDateInput = document.getElementById('booking-date');
        const confirmBtn = document.getElementById('confirm-booking-btn');
        const modal = document.getElementById('booking-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalMessage = document.getElementById('modal-message');
        const closeModalBtn = document.getElementById('close-booking-modal');

        const today = new Date().toISOString().split('T')[0];
        bookingDateInput.value = today;
        bookingDateInput.min = today;

        let selectedService = null;
        let selectedTime = null;
        let selectedEndTime = null;

        if (serviceCards.length) {
          const firstCard = serviceCards[0];
          selectedService = {
            id: firstCard.dataset.serviceId,
            name: firstCard.dataset.serviceName,
            price: firstCard.dataset.servicePrice
          };
          updateSummary();
        }

        serviceCards.forEach(card => {
          card.addEventListener('click', () => {
            serviceCards.forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            selectedService = {
              id: card.dataset.serviceId,
              name: card.dataset.serviceName,
              price: card.dataset.servicePrice
            };
            if (resultText) {
              resultText.textContent = 'Bạn đã chọn: ' + selectedService.name;
            }
            updateSummary();
          });
        });

        timeSlots.forEach(slot => {
          slot.addEventListener('click', () => {
            timeSlots.forEach(s => s.classList.remove('active'));
            slot.classList.add('active');
            selectedTime = slot.dataset.time;
            selectedEndTime = slot.dataset.end;
            updateSummary();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            const keyword = e.target.value.toLowerCase();
            serviceCards.forEach(card => {
              const text = (card.dataset.serviceName || '').toLowerCase();
              card.style.display = text.includes(keyword) ? '' : 'none';
            });
          });
        }

        bookingDateInput.addEventListener('change', updateSummary);

        function updateSummary() {
          const fmtDate = bookingDateInput.value
            ? new Date(bookingDateInput.value).toLocaleDateString('vi-VN')
            : 'Chưa chọn';

          document.getElementById('summary-service').textContent =
            selectedService ? selectedService.name : 'Chưa chọn';
          document.getElementById('summary-date').textContent = fmtDate;
          document.getElementById('summary-time').textContent = selectedTime
            ? selectedTime + ' - ' + selectedEndTime
            : 'Chưa chọn';
          document.getElementById('summary-price').textContent = selectedService
            ? Number(selectedService.price).toLocaleString('vi-VN') + ' đ'
            : '0 đ';
        }

        confirmBtn.addEventListener('click', async () => {
          if (!selectedService) { alert('Vui lòng chọn dịch vụ!'); return; }
          if (!selectedTime) { alert('Vui lòng chọn khung giờ!'); return; }
          if (!bookingDateInput.value) { alert('Vui lòng chọn ngày!'); return; }

          const startTime = bookingDateInput.value + ' ' + selectedTime + ':00';
          const endTime = bookingDateInput.value + ' ' + selectedEndTime + ':00';

          try {
            const res = await fetch('/api/booking', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                userId: '<%= userId %>',
                resourceId: selectedService.id,
                startTime: startTime,
                endTime: endTime,
                totalAmount: selectedService.price
              })
            });
            const data = await res.json();
            if (res.ok) {
              modalTitle.textContent = 'Đặt lịch thành công!';
              modalMessage.textContent = data.message || 'Lịch của bạn đã được ghi nhận.';
              modal.classList.remove('hidden');
            } else {
              modalTitle.textContent = 'Không thể đặt lịch!';
              modalMessage.textContent = data.error || 'Đã có lỗi xảy ra.';
              modal.classList.remove('hidden');
            }
          } catch (err) {
            alert('Lỗi kết nối server!');
          }
        });

        closeModalBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          window.location.href = `/my-bookings?userId=<%= userId %>&name=<%= encodeURIComponent(userName) %>`;
        });
      });
    </script>
  </body>
</html>