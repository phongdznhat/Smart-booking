<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Tài khoản — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/users.css" />
  </head>
  <body>
    <!-- ============ ICON SPRITE ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-plus" viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </symbol>
      <symbol id="i-edit" viewBox="0 0 24 24">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
      </symbol>
      <symbol id="i-trash" viewBox="0 0 24 24">
        <path d="M3 6h18" />
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </symbol>
      <symbol id="i-mail" viewBox="0 0 24 24">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-10 6L2 7" />
      </symbol>
      <symbol id="i-phone" viewBox="0 0 24 24">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      </symbol>
      <symbol id="i-shield" viewBox="0 0 24 24">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </symbol>
      <symbol id="i-users" viewBox="0 0 24 24">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </symbol>
      <symbol id="i-filter" viewBox="0 0 24 24">
        <path d="M22 3H2l8 9.5V19l4 2v-8.5z" />
      </symbol>
      <symbol id="i-empty-users" viewBox="0 0 24 24">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item is-active">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm theo tên, email…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <!-- Welcome banner -->
        <section class="hero">
          <div class="hero__text">
            <span class="hero__eyebrow">👋 Chào mừng trở lại</span>
            <h1>Xin chào đến với Smart Booking</h1>
            <p>Quản lý tài khoản người dùng trong hệ thống một cách dễ dàng và trực quan.</p>
          </div>
          <a href="/create" class="btn-primary">
            <svg class="ico ico--sm"><use href="#i-plus" /></svg>
            Tạo tài khoản mới
          </a>
        </section>

        <!-- Page head -->
        <div class="page-head">
          <div>
            <h2>Danh sách tài khoản</h2>
            <p>
              <% if (dataUser && dataUser.length) { %>
                Tổng cộng <strong class="page-head__count"><%= dataUser.length %></strong> tài khoản
              <% } else { %>
                Chưa có tài khoản nào trong hệ thống
              <% } %>
            </p>
          </div>
          <div class="page-head__actions">
            <button class="btn-ghost" type="button">
              <svg class="ico ico--sm"><use href="#i-filter" /></svg>
              Bộ lọc
            </button>
          </div>
        </div>

        <!-- Bảng users -->
        <section class="section-card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Họ tên</th>
                  <th>Email</th>
                  <th>Số điện thoại</th>
                  <th>Vai trò</th>
                  <th>Trạng thái</th>
                  <th class="th-right">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (dataUser && dataUser.length) { %>
                  <% dataUser.forEach(function(user) { %>
                    <tr>
                      <!-- Họ tên + avatar -->
                      <td>
                        <div class="user-cell">
                          <span class="user-cell__avatar">
                            <%= (user.FullName || 'U').trim().charAt(0).toUpperCase() %>
                          </span>
                          <div class="user-cell__info">
                            <span class="cell-strong"><%= user.FullName %></span>
                            <span class="user-cell__id">ID #<%= user.UserID %></span>
                          </div>
                        </div>
                      </td>

                      <!-- Email -->
                      <td>
                        <span class="icon-text">
                          <svg class="ico ico--xs"><use href="#i-mail" /></svg>
                          <%= user.Email %>
                        </span>
                      </td>

                      <!-- Số điện thoại -->
                      <td>
                        <% if (user.Phone) { %>
                          <span class="icon-text">
                            <svg class="ico ico--xs"><use href="#i-phone" /></svg>
                            <%= user.Phone %>
                          </span>
                        <% } else { %>
                          <span class="cell-muted">—</span>
                        <% } %>
                      </td>

                      <!-- Vai trò -->
                      <td>
                        <% if ((user.Role || 'user').toLowerCase() === 'admin') { %>
                          <span class="badge badge-admin">
                            <svg class="ico ico--xs"><use href="#i-shield" /></svg>
                            Admin
                          </span>
                        <% } else { %>
                          <span class="badge badge-user">
                            <svg class="ico ico--xs"><use href="#i-users" /></svg>
                            User
                          </span>
                        <% } %>
                      </td>

                      <!-- Trạng thái -->
                      <td>
                        <% if ((user.Status || 'active') === 'active') { %>
                          <span class="status status--active">
                            <span class="status__dot"></span> Hoạt động
                          </span>
                        <% } else { %>
                          <span class="status status--locked">
                            <span class="status__dot"></span> Đã khóa
                          </span>
                        <% } %>
                      </td>

                      <!-- Thao tác -->
                      <td>
                        <div class="actions">
                          <a
                            href="/update/<%= user.UserID %>"
                            class="btn-icon btn-edit"
                          >
                            <svg class="ico ico--sm"><use href="#i-edit" /></svg>
                            Sửa
                          </a>
                          <form
                            action="/delete-user"
                            method="post"
                            onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?');"
                          >
                            <input type="hidden" name="id" value="<%= user.UserID %>" />
                            <button type="submit" class="btn-icon btn-delete">
                              <svg class="ico ico--sm"><use href="#i-trash" /></svg>
                              Xóa
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="empty">
                      <div class="empty__icon">
                        <svg class="ico"><use href="#i-empty-users" /></svg>
                      </div>
                      <p class="empty__title">Chưa có tài khoản nào</p>
                      <p class="empty__sub">
                        Bấm nút <strong>“Tạo tài khoản mới”</strong> để bắt đầu thêm người dùng.
                      </p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>