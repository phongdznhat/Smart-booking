<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tạo tài khoản — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/create-user.css" />
  <link rel="icon" type="image/png" href="/image/favicon.png">
  </head>
  <body>
    <!-- ============ ICON SPRITE ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path
          d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
        />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-user" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </symbol>
      <symbol id="i-mail" viewBox="0 0 24 24">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-10 6L2 7" />
      </symbol>
      <symbol id="i-phone" viewBox="0 0 24 24">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        />
      </symbol>
      <symbol id="i-lock" viewBox="0 0 24 24">
        <rect x="3" y="11" width="18" height="11" rx="2.5" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </symbol>
      <symbol id="i-eye" viewBox="0 0 24 24">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
        <circle cx="12" cy="12" r="3" />
      </symbol>
      <symbol id="i-eye-off" viewBox="0 0 24 24">
        <path
          d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"
        />
        <path
          d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"
        />
        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
        <path d="m1 1 22 22" />
      </symbol>
      <symbol id="i-arrow-left" viewBox="0 0 24 24">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-shield" viewBox="0 0 24 24">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item is-active">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <!-- Lớp phủ khi mở menu trên mobile -->
    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <!-- Breadcrumb / back link -->
        <a href="/dashboard" class="back-link">
          <svg class="ico ico--sm"><use href="#i-arrow-left" /></svg>
          Quay lại Dashboard
        </a>

        <!-- Bố cục 2 cột: form + panel phụ -->
        <div class="page-grid">
          <!-- ===== FORM ===== -->
          <section class="form-card">
            <header class="form-card__head">
              <div class="form-card__icon">
                <svg class="ico"><use href="#i-user-plus" /></svg>
              </div>
              <div>
                <h1>Tạo tài khoản mới</h1>
                <p>Điền thông tin bên dưới để thêm người dùng vào hệ thống.</p>
              </div>
            </header>

            <form
              action="/create-user"
              method="post"
              class="form"
              id="createUserForm"
            >
              <!-- Họ tên -->
              <div class="field">
                <label for="name">Họ tên <span class="required">*</span></label>
                <div class="input-wrap">
                  <svg class="ico input-wrap__icon"><use href="#i-user" /></svg>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Nguyễn Văn A"
                    autocomplete="name"
                    required
                  />
                </div>
              </div>

              <!-- Email -->
              <div class="field">
                <label for="email">Email <span class="required">*</span></label>
                <div class="input-wrap">
                  <svg class="ico input-wrap__icon"><use href="#i-mail" /></svg>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="nguyenvana@example.com"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>

              <!-- Số điện thoại -->
              <div class="field">
                <label for="phone">Số điện thoại</label>
                <div class="input-wrap">
                  <svg class="ico input-wrap__icon">
                    <use href="#i-phone" />
                  </svg>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="0901 234 567"
                    autocomplete="tel"
                    inputmode="tel"
                  />
                </div>
              </div>

              <!-- Mật khẩu -->
              <div class="field">
                <label for="password"
                  >Mật khẩu <span class="required">*</span></label
                >
                <div class="input-wrap">
                  <svg class="ico input-wrap__icon"><use href="#i-lock" /></svg>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Tối thiểu 6 ký tự"
                    autocomplete="new-password"
                    minlength="6"
                    required
                  />
                  <button
                    type="button"
                    class="toggle-pwd"
                    aria-label="Hiện/ẩn mật khẩu"
                    data-target="password"
                  >
                    <svg class="ico ico--sm"><use href="#i-eye" /></svg>
                  </button>
                </div>
                <p class="field__hint">
                  Sử dụng mật khẩu mạnh để bảo mật tài khoản.
                </p>
              </div>

              <!-- Vai trò -->
              <div class="field">
                <label for="role">Vai trò</label>
                <div class="input-wrap">
                  <select id="role" name="role" style="width: 100%; border: none; outline: none; background: transparent; padding: 12px; font-family: inherit; font-size: 14px; color:#0f172a">
                    <option value="user">Khách hàng (User)</option>
                    <option value="admin">Quản trị viên (Admin)</option>
                  </select>
                </div>
              </div>

              <!-- Nút submit -->
              <div class="form__actions">
                <a href="/dashboard" class="btn-cancel">Hủy</a>
                <button type="submit" class="btn-primary">
                  <svg class="ico ico--sm"><use href="#i-check" /></svg>
                  Tạo tài khoản
                </button>
              </div>
            </form>
          </section>

          <!-- ===== PANEL PHỤ ===== -->
          <aside class="side-info">
            <!-- Card bảo mật -->
            <div class="info-card">
              <div class="info-card__icon info-card__icon--teal">
                <svg class="ico"><use href="#i-shield" /></svg>
              </div>
              <h3>Bảo mật tài khoản</h3>
              <p>
                Tài khoản mới sẽ được tạo với vai trò <strong>User</strong>. Bạn
                có thể nâng cấp quyền sau trong phần Quản lý tài khoản.
              </p>
            </div>

            <!-- Checklist gợi ý -->
            <div class="info-card">
              <h3>Yêu cầu bắt buộc</h3>
              <ul class="checklist">
                <li>
                  <span class="checklist__dot"
                    ><svg class="ico ico--xs"><use href="#i-check" /></svg
                  ></span>
                  Họ tên đầy đủ
                </li>
                <li>
                  <span class="checklist__dot"
                    ><svg class="ico ico--xs"><use href="#i-check" /></svg
                  ></span>
                  Email hợp lệ và chưa tồn tại
                </li>
                <li>
                  <span class="checklist__dot"
                    ><svg class="ico ico--xs"><use href="#i-check" /></svg
                  ></span>
                  Mật khẩu từ 6 ký tự
                </li>
              </ul>
            </div>

            <!-- Gợi ý -->
            <div class="info-card info-card--tip">
              <h3>💡 Gợi ý</h3>
              <p>
                Sau khi tạo, bạn có thể gửi thông tin đăng nhập cho người dùng
                qua email để họ đổi mật khẩu ở lần đăng nhập đầu tiên.
              </p>
            </div>
          </aside>
        </div>
      </main>
    </div>

    <!-- Toggle hiển thị mật khẩu -->
    <script>
      document.querySelectorAll(".toggle-pwd").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var input = document.getElementById(btn.dataset.target);
          if (!input) return;
          var isPwd = input.type === "password";
          input.type = isPwd ? "text" : "password";
          btn.innerHTML = isPwd
            ? '<svg class="ico ico--sm"><use href="#i-eye-off" /></svg>'
            : '<svg class="ico ico--sm"><use href="#i-eye" /></svg>';
        });
      });
    </script>
  </body>
</html>
