<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sửa Dịch vụ — Smart Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/resource-edit.css" />
  <link rel="icon" type="image/png" href="/image/favicon.png">
  </head>
  <body>
    <!-- ============ ICON SPRITE ============ -->
    <svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="i-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="3" width="7" height="7" rx="1.6" />
        <rect x="14" y="14" width="7" height="7" rx="1.6" />
        <rect x="3" y="14" width="7" height="7" rx="1.6" />
      </symbol>
      <symbol id="i-package" viewBox="0 0 24 24">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </symbol>
      <symbol id="i-calendar" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2.5" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </symbol>
      <symbol id="i-user-plus" viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M19 8v6M22 11h-6" />
      </symbol>
      <symbol id="i-logout" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </symbol>
      <symbol id="i-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </symbol>
      <symbol id="i-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </symbol>
      <symbol id="i-edit" viewBox="0 0 24 24">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-arrow-left" viewBox="0 0 24 24">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </symbol>
      <symbol id="i-tag" viewBox="0 0 24 24">
        <path d="M20.59 13.41 12 22l-9-9V4a1 1 0 0 1 1-1h9z" />
        <circle cx="7.5" cy="7.5" r="1.5" />
      </symbol>
      <symbol id="i-dollar" viewBox="0 0 24 24">
        <path d="M12 1v22" />
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
      </symbol>
      <symbol id="i-align-left" viewBox="0 0 24 24">
        <path d="M3 6h18M3 12h12M3 18h15" />
      </symbol>
      <symbol id="i-info" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 16v-4M12 8h.01" />
      </symbol>
      <symbol id="i-activity" viewBox="0 0 24 24">
        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
      </symbol>
      <symbol id="i-alert" viewBox="0 0 24 24">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z" />
        <path d="M12 9v4M12 17h.01" />
      </symbol>
      <symbol id="i-wrench" viewBox="0 0 24 24">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
      </symbol>
      <symbol id="i-power" viewBox="0 0 24 24">
        <path d="M18.36 6.64a9 9 0 1 1-12.73 0" />
        <path d="M12 2v10" />
      </symbol>
    </svg>

    <!-- ============ ĐIỀU KHIỂN SIDEBAR (mobile) ============ -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <span class="brand__mark">SB</span>
        <span class="brand__text">Smart<strong>Booking</strong></span>
      </div>

      <nav class="sidebar__nav">
        <p class="nav__label">Menu chính</p>

        <a href="/admin/dashboard" class="nav__item">
          <svg class="ico"><use href="#i-grid" /></svg>
          <span>Tổng quan</span>
        </a>
        <a href="/admin/resources" class="nav__item is-active">
          <svg class="ico"><use href="#i-package" /></svg>
          <span>Dịch vụ</span>
        </a>
        <a href="/admin/bookings" class="nav__item">
          <svg class="ico"><use href="#i-calendar" /></svg>
          <span>Lịch đặt</span>
        </a>
        <a href="/create" class="nav__item">
          <svg class="ico"><use href="#i-user-plus" /></svg>
          <span>Thêm User</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <a href="/login" class="nav__item nav__item--danger">
          <svg class="ico"><use href="#i-logout" /></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </aside>

    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <!-- ============ NỘI DUNG ============ -->
    <div class="layout">
      <!-- Topbar -->
      <header class="topbar">
        <label for="nav-toggle" class="hamburger" aria-label="Mở menu">
          <svg class="ico"><use href="#i-menu" /></svg>
        </label>

        <div class="search">
          <svg class="ico"><use href="#i-search" /></svg>
          <input type="search" placeholder="Tìm kiếm…" />
        </div>

        <div class="topbar__right">
          <button class="icon-btn" type="button" aria-label="Thông báo">
            <svg class="ico"><use href="#i-bell" /></svg>
            <span class="icon-btn__dot"></span>
          </button>

          <div class="user-chip">
            <span class="avatar">AD</span>
            <span class="user-chip__meta">
              <strong>Admin</strong>
              <small>Quản trị viên</small>
            </span>
          </div>
        </div>
      </header>

      <!-- Main -->
      <main class="main">
        <!-- Back link -->
        <a href="/admin/resources" class="back-link">
          <svg class="ico ico--sm"><use href="#i-arrow-left" /></svg>
          Quay lại danh sách dịch vụ
        </a>

        <!-- Grid 2 cột -->
        <div class="page-grid">
          <!-- ===== FORM ===== -->
          <section class="form-card">
            <header class="form-card__head">
              <div class="form-card__icon form-card__icon--edit">
                <svg class="ico"><use href="#i-edit" /></svg>
              </div>
              <div>
                <h1>Chỉnh sửa Dịch vụ</h1>
                <p>
                  Cập nhật thông tin cho dịch vụ
                  <strong class="resource-tag">#<%= resource.ResourceID %></strong>
                </p>
              </div>
            </header>

            <form action="/admin/resources/update" method="post" class="form" enctype="multipart/form-data">
              <div class="field">
  <label for="resource-image">Ảnh đại diện dịch vụ</label>

  <!-- Ảnh hiện tại (nếu có) -->
  <% if (resource.ImageUrl) { %>
    <div class="current-image" id="currentImageBlock">
      <div class="current-image__media">
        <img src="<%= resource.ImageUrl %>" alt="Ảnh hiện tại" />
        <span class="current-image__badge">
          <svg class="ico ico--xs" viewBox="0 0 24 24">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          Đang sử dụng
        </span>
      </div>
      <div class="current-image__meta">
        <span class="current-image__label">Ảnh hiện tại</span>
        <span class="current-image__hint">Chọn ảnh mới bên dưới để thay đổi</span>
      </div>
    </div>
  <% } %>

  <!-- Dropzone upload ảnh mới -->
  <label class="file-upload" for="resource-image" id="fileDrop">
    <input
      type="file"
      id="resource-image"
      name="image"
      accept="image/*"
      class="file-upload__input"
    />

    <!-- Trạng thái mặc định -->
    <span class="file-upload__placeholder" id="filePlaceholder">
      <span class="file-upload__icon">
        <svg class="ico" viewBox="0 0 24 24">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <path d="M17 8l-5-5-5 5M12 3v12" />
        </svg>
      </span>
      <span class="file-upload__title">
        <%= resource.ImageUrl ? 'Chọn ảnh mới để thay thế' : 'Chọn ảnh hoặc kéo thả vào đây' %>
      </span>
      <span class="file-upload__hint">PNG, JPG, WEBP · Tối đa 5MB</span>
    </span>

    <!-- Preview ảnh mới vừa chọn -->
    <span class="file-upload__preview hidden" id="filePreview">
      <img id="filePreviewImg" alt="Preview ảnh mới" />
      <span class="file-upload__preview-badge">Ảnh mới</span>
      <span class="file-upload__overlay">
        <span class="file-upload__change">
          <svg class="ico ico--sm" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
          </svg>
          Đổi ảnh khác
        </span>
      </span>
      <button type="button" class="file-upload__remove" id="fileRemove" aria-label="Bỏ ảnh mới">
        <svg class="ico ico--sm" viewBox="0 0 24 24">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </span>
  </label>

  <p class="field__hint" id="fileName"></p>
</div>
              <input type="hidden" name="id" value="<%= resource.ResourceID %>" />

              <!-- Tên dịch vụ -->
              <div class="field">
                <label for="name">
                  Tên dịch vụ <span class="required">*</span>
                </label>
                <div class="input-wrap">
                  <svg class="ico input-wrap__icon"><use href="#i-package" /></svg>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= resource.Name || '' %>"
                    placeholder="Ví dụ: Phòng họp VIP, Khám tổng quát…"
                    required
                  />
                </div>
              </div>

              <!-- Mô tả -->
              <div class="field">
                <label for="description">Mô tả ngắn</label>
                <div class="input-wrap input-wrap--textarea">
                  <svg class="ico input-wrap__icon"><use href="#i-align-left" /></svg>
                  <textarea
                    id="description"
                    name="description"
                    rows="4"
                    placeholder="Mô tả chi tiết về dịch vụ này…"
                  ><%= resource.Description || '' %></textarea>
                </div>
              </div>

              <!-- 2 cột: phân loại + giá -->
              <div class="field-row">
                <!-- Phân loại -->
                <div class="field">
                  <label for="type">Phân loại</label>
                  <div class="input-wrap input-wrap--select">
                    <svg class="ico input-wrap__icon"><use href="#i-tag" /></svg>
                    <select id="type" name="type">
                      <option value="Phòng họp" <%= resource.Type === 'Phòng họp' ? 'selected' : '' %>>Phòng họp</option>
                      <option value="Y tế" <%= resource.Type === 'Y tế' ? 'selected' : '' %>>Y tế / Khám bệnh</option>
                      <option value="Nhà hàng" <%= resource.Type === 'Nhà hàng' ? 'selected' : '' %>>Bàn nhà hàng</option>
                      <option value="Bảo trì" <%= resource.Type === 'Bảo trì' ? 'selected' : '' %>>Dịch vụ sửa chữa / Bảo trì</option>
                      <option value="Khác" <%= resource.Type === 'Khác' ? 'selected' : '' %>>Khác</option>
                    </select>
                    <svg class="ico input-wrap__caret" viewBox="0 0 24 24">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </div>
                </div>

                <!-- Giá -->
                <div class="field">
                  <label for="price">Giá tiền (VNĐ)</label>
                  <div class="input-wrap">
                    <svg class="ico input-wrap__icon"><use href="#i-dollar" /></svg>
                    <input
                      type="number"
                      id="price"
                      name="price"
                      value="<%= resource.Price || 0 %>"
                      placeholder="0"
                      min="0"
                      step="1000"
                    />
                    <span class="input-wrap__suffix">đ</span>
                  </div>
                </div>
              </div>

              <!-- Trạng thái -->
              <div class="field">
                <label>Trạng thái</label>
                <div class="status-picker">
                  <label class="status-option status-option--available">
                    <input
                      type="radio"
                      name="status"
                      value="available"
                      <%= resource.Status === 'available' ? 'checked' : '' %>
                    />
                    <span class="status-option__icon">
                      <svg class="ico ico--sm"><use href="#i-activity" /></svg>
                    </span>
                    <span class="status-option__text">
                      <strong>Hoạt động</strong>
                      <small>Cho phép khách đặt lịch</small>
                    </span>
                  </label>

                  <label class="status-option status-option--maintenance">
                    <input
                      type="radio"
                      name="status"
                      value="maintenance"
                      <%= resource.Status === 'maintenance' ? 'checked' : '' %>
                    />
                    <span class="status-option__icon">
                      <svg class="ico ico--sm"><use href="#i-wrench" /></svg>
                    </span>
                    <span class="status-option__text">
                      <strong>Đang bảo trì</strong>
                      <small>Tạm dừng nhận lịch đặt</small>
                    </span>
                  </label>

                  <label class="status-option status-option--out">
                    <input
                      type="radio"
                      name="status"
                      value="out_of_service"
                      <%= resource.Status === 'out_of_service' ? 'checked' : '' %>
                    />
                    <span class="status-option__icon">
                      <svg class="ico ico--sm"><use href="#i-power" /></svg>
                    </span>
                    <span class="status-option__text">
                      <strong>Ngưng phục vụ</strong>
                      <small>Không còn khả dụng</small>
                    </span>
                  </label>
                </div>
              </div>

              <!-- Actions -->
              <div class="form__actions">
                <a href="/admin/resources" class="btn-cancel">Hủy bỏ</a>
                <button type="submit" class="btn-primary">
                  <svg class="ico ico--sm"><use href="#i-check" /></svg>
                  Lưu thay đổi
                </button>
              </div>
            </form>
          </section>

          <!-- ===== PANEL PHỤ ===== -->
          <aside class="side-info">
            <!-- Thông tin dịch vụ -->
            <div class="info-card info-card--summary">
              <div class="summary-head">
                <div class="summary-icon">
                  <svg class="ico"><use href="#i-package" /></svg>
                </div>
                <div class="summary-meta">
                  <span class="summary-id">#<%= resource.ResourceID %></span>
                  <span class="summary-name"><%= resource.Name || 'Chưa đặt tên' %></span>
                </div>
              </div>

              <div class="summary-rows">
                <div class="summary-row">
                  <span class="summary-row__label">Phân loại</span>
                  <span class="summary-row__value"><%= resource.Type || 'Khác' %></span>
                </div>
                <div class="summary-row">
                  <span class="summary-row__label">Giá</span>
                  <span class="summary-row__value summary-row__value--money">
                    <%= resource.Price && Number(resource.Price) > 0
                        ? Number(resource.Price).toLocaleString('vi-VN') + ' đ'
                        : 'Miễn phí' %>
                  </span>
                </div>
                <div class="summary-row">
                  <span class="summary-row__label">Trạng thái</span>
                  <span class="summary-row__value">
                    <% if (resource.Status === 'available') { %>
                      <span class="badge badge-available">
                        <span class="badge__dot"></span> Hoạt động
                      </span>
                    <% } else if (resource.Status === 'maintenance') { %>
                      <span class="badge badge-maintenance">
                        <span class="badge__dot"></span> Bảo trì
                      </span>
                    <% } else { %>
                      <span class="badge badge-out">
                        <span class="badge__dot"></span> Ngưng
                      </span>
                    <% } %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Cảnh báo -->
            <div class="info-card info-card--warn">
              <div class="info-card__icon info-card__icon--amber">
                <svg class="ico"><use href="#i-alert" /></svg>
              </div>
              <h3>Lưu ý khi chỉnh sửa</h3>
              <p>
                Thay đổi <strong>trạng thái</strong> sẽ ảnh hưởng trực tiếp đến khả
                năng đặt lịch của khách hàng. Vui lòng kiểm tra kỹ trước khi lưu.
              </p>
            </div>

            <!-- Tips -->
            <div class="info-card">
              <div class="info-card__icon info-card__icon--teal">
                <svg class="ico"><use href="#i-info" /></svg>
              </div>
              <h3>Gợi ý</h3>
              <ul class="tips">
                <li>Đặt <strong>giá = 0</strong> nếu dịch vụ miễn phí.</li>
                <li>Dùng trạng thái <strong>Bảo trì</strong> khi tạm dừng ngắn hạn.</li>
                <li>Chuyển <strong>Ngưng phục vụ</strong> khi không còn kinh doanh dịch vụ.</li>
              </ul>
            </div>
          </aside>
        </div>
      </main>
    </div>
  
    <script>
      const fileInput = document.getElementById('resource-image');
      const fileDrop = document.getElementById('fileDrop');
      const filePlaceholder = document.getElementById('filePlaceholder');
      let filePreview = document.getElementById('filePreview');
      
      if (fileInput && fileDrop) {
        // Create preview element if not exists
        if (!filePreview) {
          filePreview = document.createElement('div');
          filePreview.id = 'filePreview';
          filePreview.className = 'file-upload__preview hidden';
          filePreview.innerHTML = `
            <span class="file-upload__preview-badge">Ảnh mới</span>
            <img id="previewImg" src="" alt="Preview">
            <div class="file-upload__overlay">
              <span class="file-upload__change">
                <svg class="ico ico--sm"><use href="#i-refresh"></use></svg>
                Đổi ảnh khác
              </span>
            </div>
            <button type="button" class="file-upload__remove" id="removeFileBtn" aria-label="Xóa ảnh">
              <svg class="ico"><use href="#i-x"></use></svg>
            </button>
          `;
          fileDrop.appendChild(filePreview);
        }

        const previewImg = document.getElementById('previewImg');
        const removeFileBtn = document.getElementById('removeFileBtn');

        fileInput.addEventListener('change', function() {
          if (this.files && this.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
              if(filePlaceholder) filePlaceholder.classList.add('hidden');
              if(filePreview) {
                filePreview.classList.remove('hidden');
                if(previewImg) previewImg.src = e.target.result;
              }
            }
            reader.readAsDataURL(this.files[0]);
          } else {
            resetPreview();
          }
        });

        if(removeFileBtn) {
          removeFileBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            resetPreview();
          });
        }

        function resetPreview() {
          fileInput.value = '';
          if(filePlaceholder) filePlaceholder.classList.remove('hidden');
          if(filePreview) filePreview.classList.add('hidden');
          if(previewImg) previewImg.src = '';
        }
      }
    </script>
  </body>

</html>